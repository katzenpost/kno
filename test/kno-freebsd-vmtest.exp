#!/usr/bin/expect -f
set timeout 480
set disk   [lindex $argv 0]
set pkgurl [lindex $argv 1]
set vars   [lindex $argv 2]
set ovmf   [lindex $argv 3]

spawn qemu-system-x86_64 -enable-kvm -m 2560 -smp 2 \
    -drive if=pflash,format=raw,unit=0,readonly=on,file=$ovmf \
    -drive if=pflash,format=raw,unit=1,file=$vars \
    -drive file=$disk,if=virtio -snapshot \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
    -display none -serial stdio -monitor none

expect {
    timeout { puts "\nTIMEOUT waiting for login"; exit 2 }
    -re "login: ?$" { send "root\r" }
}
expect {
    timeout { puts "\nTIMEOUT after username"; exit 2 }
    -re "assword:" { send "\r"; exp_continue }
    -re "root@" { }
}

send "\r"
expect -re "\[#$] $"
send "KP1=KNO; KP2='> '; PS1=\"\$KP1\$KP2\"\r"
expect -re "KNO> $"

proc run {cmd tmo} {
    send "$cmd\r"
    set oldt $::timeout
    set ::timeout $tmo
    expect {
        timeout { puts "\nTIMEOUT on: $cmd"; exit 2 }
        -re "KNO> $" { }
    }
    set ::timeout $oldt
}

run "dhclient vtnet0 2>/dev/null; ifconfig vtnet0 | grep 'inet '" 40
run "fetch -q -o /tmp/k.pkg $pkgurl && ls -l /tmp/k.pkg || echo FETCH_FAIL" 60
run "sha256 /tmp/k.pkg" 20
run "env ASSUME_ALWAYS_YES=yes pkg add /tmp/k.pkg >/tmp/add.log 2>&1; rc=\$?; tail -3 /tmp/add.log; echo ADD_RC=\$rc" 240
run "pkg info katzenpost 2>&1 | head" 20
run "pkg info -l katzenpost 2>&1 | head -20" 20
run "/usr/local/bin/kpgenkeypair --help >/dev/null 2>&1; echo GENKEYPAIR_RC=\$?" 30
run "/usr/local/sbin/kpserver -h >/dev/null 2>&1; echo SERVER_RC=\$?" 30
run "/usr/local/sbin/kpdirauth -v >/tmp/da.log 2>&1; rc=\$?; head -1 /tmp/da.log; echo DIRAUTH_RC=\$rc" 30

send "poweroff\r"
expect {
    timeout { exit 0 }
    eof { }
}
