#!/usr/bin/expect -f
set timeout 1800
set disk      [lindex $argv 0]
set jailsdisk [lindex $argv 1]
set baseurl   [lindex $argv 2]
set pkgbase   [lindex $argv 3]
set vars      [lindex $argv 4]
set ovmf      [lindex $argv 5]
set smp [expr {[info exists ::env(KNO_VMTEST_SMP)] ? $::env(KNO_VMTEST_SMP) : 2}]
set mem [expr {[info exists ::env(KNO_VMTEST_MEM)] ? $::env(KNO_VMTEST_MEM) : 3072}]

spawn qemu-system-x86_64 -enable-kvm -m $mem -smp $smp \
    -drive if=pflash,format=raw,unit=0,readonly=on,file=$ovmf \
    -drive if=pflash,format=raw,unit=1,file=$vars \
    -drive file=$disk,if=virtio -snapshot \
    -drive file=$jailsdisk,if=virtio,format=qcow2 \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
    -display none -serial stdio -monitor none

expect {
    timeout { puts "\nTIMEOUT waiting for login"; exit 2 }
    -re "login: ?$" { send "root\r" }
}
expect {
    timeout { puts "\nTIMEOUT after username"; exit 2 }
    -re "assword:" { send "\r"; exp_continue }
    -re "root@" { }
}
send "\r"
expect -re "\[#$] $"
send "KP1=KNO; KP2='> '; PS1=\"\$KP1\$KP2\"\r"
expect -re "KNO> $"

proc run {cmd tmo} {
    send "$cmd\r"
    set oldt $::timeout
    set ::timeout $tmo
    expect {
        timeout { puts "\nTIMEOUT on: $cmd"; exit 2 }
        -re "KNO> $" { }
    }
    set ::timeout $oldt
}

run "dhclient vtnet0 2>/dev/null; ifconfig vtnet0 | grep 'inet '" 60
run "newfs -U /dev/vtbd1 >/dev/null 2>&1 && mkdir -p /jails && mount /dev/vtbd1 /jails && df -h /jails | tail -1; echo JAILFS_RC=\$?" 180
run "fetch -q -o /tmp/base.txz $baseurl; echo BASEDL_RC=\$?" 900

run "for j in respectmy allmixedup; do mkdir -p /jails/\$j; tar -xf /tmp/base.txz -C /jails/\$j; cp /etc/resolv.conf /jails/\$j/etc/resolv.conf; done; ls /jails/respectmy/bin/sh /jails/allmixedup/bin/sh >/dev/null 2>&1; echo JAILS_RC=\$?" 900
run "rc=0; for j in respectmy allmixedup; do jail -c name=\$j path=/jails/\$j host.hostname=\$j.local ip4=inherit allow.raw_sockets persist || rc=1; done; jls; echo JAILUP_RC=\$rc" 180

run "fetch -q -o /tmp/katzenpost.pkg $pkgbase/katzenpost.pkg && fetch -q -o /tmp/cfg-respectmy.pkg $pkgbase/cfg-respectmy.pkg && fetch -q -o /tmp/cfg-allmixedup.pkg $pkgbase/cfg-allmixedup.pkg; echo PKGDL_RC=\$?" 600
run "cp /tmp/katzenpost.pkg /jails/respectmy/tmp/ && cp /tmp/cfg-respectmy.pkg /jails/respectmy/tmp/ && cp /tmp/katzenpost.pkg /jails/allmixedup/tmp/ && cp /tmp/cfg-allmixedup.pkg /jails/allmixedup/tmp/; echo COPY_RC=\$?" 180

run "env ASSUME_ALWAYS_YES=yes pkg -c /jails/respectmy add /tmp/cfg-respectmy.pkg >/tmp/dep.log 2>&1; rc=\$?; tail -2 /tmp/dep.log; \[ \$rc -ne 0 \]; echo DEPGUARD_RC=\$?" 300

run "env ASSUME_ALWAYS_YES=yes pkg -c /jails/respectmy add /tmp/katzenpost.pkg /tmp/cfg-respectmy.pkg >/tmp/add1.log 2>&1; rc=\$?; tail -3 /tmp/add1.log; echo ADD1_RC=\$rc" 600
run "env ASSUME_ALWAYS_YES=yes pkg -c /jails/allmixedup add /tmp/katzenpost.pkg /tmp/cfg-allmixedup.pkg >/tmp/add2.log 2>&1; rc=\$?; tail -3 /tmp/add2.log; echo ADD2_RC=\$rc" 600

run "cat /jails/respectmy/usr/local/etc/rc.conf.d/katzenpost; echo RC1_RC=\$?" 60
run "cat /jails/allmixedup/usr/local/etc/rc.conf.d/katzenpost; echo RC2_RC=\$?" 60
run "grep -q 'kpdirauth' /jails/respectmy/usr/local/etc/rc.conf.d/katzenpost && grep -q 'katzenpost_prestart' /jails/respectmy/usr/local/etc/rc.conf.d/katzenpost; echo AUTHCFG_RC=\$?" 60
run "grep -q 'kpserver' /jails/allmixedup/usr/local/etc/rc.conf.d/katzenpost && ! grep -q 'katzenpost_prestart' /jails/allmixedup/usr/local/etc/rc.conf.d/katzenpost; echo GWCFG_RC=\$?" 60
run "ls /jails/respectmy/var/lib/pq-katzenpost-authority/*.pem >/tmp/af.log 2>&1 && ls /jails/respectmy/usr/local/etc/katzenpost/authority/config.toml >/dev/null 2>&1; rc=\$?; wc -l </tmp/af.log; echo AUTHFILES_RC=\$rc" 60
run "ls /jails/respectmy/var/lib/pq-katzenpost-authority/ >/tmp/ns.log 2>&1 && ! grep private /tmp/ns.log; echo NOSECRET_RC=\$?" 60

run "jexec respectmy /bin/sh -c 'service katzenpost rcvar' >/tmp/rv.log 2>&1; rc=\$?; head -4 /tmp/rv.log; echo RCVAR_RC=\$rc" 120
run "jexec respectmy /bin/sh -c 'service katzenpost start' >/tmp/s1.log 2>&1; rc=\$?; tail -3 /tmp/s1.log; echo START1_RC=\$rc" 300
run "jexec respectmy /bin/sh -c '/usr/local/sbin/kpdirauth -f /usr/local/etc/katzenpost/authority/config.toml' >/tmp/st1.log 2>&1; grep -q 'identity.public.pem: no such file' /tmp/st1.log; rc=\$?; tail -3 /tmp/st1.log; echo STATUS1_RC=\$rc" 180
run "jexec allmixedup /bin/sh -c 'service katzenpost start' >/tmp/s2.log 2>&1; rc=\$?; tail -3 /tmp/s2.log; echo START2_RC=\$rc" 300
run "sleep 8; jexec allmixedup /bin/sh -c 'service katzenpost status' >/tmp/st2.log 2>&1; rc=\$?; tail -2 /tmp/st2.log; echo STATUS2_RC=\$rc" 180

run "jexec respectmy /bin/sh -c 'service katzenpost stop' >/dev/null 2>&1; jexec allmixedup /bin/sh -c 'service katzenpost stop' >/dev/null 2>&1; echo STOP_RC=0" 180
run "for j in allmixedup respectmy; do jail -r \$j >/dev/null 2>&1; done; echo TEARDOWN_RC=0" 120

send "poweroff\r"
expect {
    timeout { exit 0 }
    eof { }
}
