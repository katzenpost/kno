#!/bin/sh

# Simple restart loop for katzenpost with logging

CONFIG_FILE="$1"
LOGFILE="/var/log/katzenpost"

if [ -z "$CONFIG_FILE" ]; then
    echo "Usage: $0 <config-file>" >&2
    exit 1
fi

# Ensure log file exists
if [ ! -f "$LOGFILE" ]; then
    touch "$LOGFILE" || {
        echo "Cannot create log file $LOGFILE" >&2
        exit 1
    }
fi

while :; do
    echo "[$(date -u)] starting katzenpost-dirauth -f $CONFIG_FILE" >> "$LOGFILE" 2>&1
    /usr/local/sbin/katzenpost-dirauth -f "$CONFIG_FILE" >> "$LOGFILE" 2>&1
    rc=$?
    echo "[$(date -u)] katzenpost-dirauth exited with status $rc, restarting in 5 seconds..." >> "$LOGFILE" 2>&1
    sleep 5
done
