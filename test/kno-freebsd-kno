#!/bin/sh
# shellcheck disable=SC2016
set -eu

SELF=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
V="$SELF/kno-freebsd-vm"
src="${1:?usage: kno-freebsd-kno <scratch checkout> <kno.toml>}"
cfg="${2:?usage: kno-freebsd-kno <scratch checkout> <kno.toml>}"
W="${KNO_FBSD_KNO_DIR:-/var/tmp/kno-fbsd-kno}"
host="${KNO_FBSD_KNO_HOST:-pietje}"
tag="${KNO_FBSD_KNO_TAG:-v0.0.107}"
log="$W/run.log"
J=/usr/jails
KJ=$J/kno
C=$KJ/var/jail
KR=$KJ/var/db/kno/roots
NK=/var/tmp/kno-node-keys
ST=$KJ/var/db/kno/state

export GIT_SSH_COMMAND=false GIT_TERMINAL_PROMPT=0 SSH_ASKPASS_REQUIRE=never
mkdir -p "$W"
: >"$log"

say() { echo "== $*" | tee -a "$log"; }
keys() {
	ki=kpauthority/identity.private.pem
	kl=kpserver/link.private.pem
	if vm "cmp $NK/$ki $ST/$ki && cmp $NK/$kl $ST/$kl"; then
		mark "$1" 0
	else
		mark "$1" 1
	fi
}
mark() { echo "${1}_RC=$2" | tee -a "$log"; }
vm() { "$V" ssh "$@"; }
ship() {
	git -C "$src" bundle create "$W/kno.bundle" "$(git -C "$src" branch --show-current)" HEAD >/dev/null 2>&1
	"$V" scp "$W/kno.bundle" vm:$KJ/root/kno.bundle
}
record() {
	if git -C "$src" update-ref refs/remotes/origin/main HEAD &&
		KNO_CONFIG="$cfg" KNO_REPO="$src/data" KNO_ARTIFACTS="$W/art" "$W/kno" build --host "$host" >>"$W/build.log" 2>&1 &&
		KNO_REPO="$src/data" "$W/kno" build record --dir "$rel/pkgs" >>"$W/build.log" 2>&1 &&
		git -C "$src" add "data/networks/namenlos/.generated/releases/$tag" &&
		git -C "$src" -c user.email=jacob@appelbaum.net commit -q -m "fixture: record $1"; then
		mark "RECORD_$1" 0
	else
		mark "RECORD_$1" 1
	fi
}
vmstep() {
	vm "export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin; { $2; } 2>&1; echo ${1}_RC=\$?" 2>&1 | tee -a "$log"
}
new="[ \"\$(jexec kno jls -j kpauthority path)\" = /var/jail/kpauthority ] && [ \"\$(jexec kno jls -j kpserver path)\" = /var/jail/kpserver ] &&
	[ \"\$(jexec kno jls -j kpclientd path)\" = /var/jail/kpclientd ] &&
	procstat -b \"\$(cat $C/kpauthority/var/run/katzenpost.child.pid)\" | grep -q '/usr/local/sbin/kpdirauth\$' &&
	procstat -b \"\$(cat $C/kpserver/var/run/katzenpost.child.pid)\" | grep -q '/usr/local/sbin/kpserver\$' &&
	procstat -b \"\$(cat $C/kpclientd/var/run/kpclientd.child.pid)\" | grep -q '/usr/local/bin/kpclientd\$'"
listen='sockstat -46 -l -j kno.kpauthority | grep -q "kpdirauth.*:1984 " && sockstat -46 -l -j kno.kpserver | grep -q "kpserver.*:8443 "'
readonly='for j in kpauthority kpserver kpclientd; do for d in / /etc /usr /usr/local /usr/local/etc /bin /var; do
		if jexec kno.$j /bin/sh -c ": >$d/kno-w" 2>/dev/null; then echo "WRITABLE $j:$d"; exit 1; fi; done
		for d in /var/run /tmp /var/log; do jexec kno.$j /bin/sh -c ": >$d/kno-w && rm $d/kno-w" || exit 1; done; done &&
	jexec kno.kpauthority /bin/sh -c ": >/var/lib/pq-katzenpost-authority/kno-w && rm /var/lib/pq-katzenpost-authority/kno-w"'
isolated='jls -j kno.kpclientd >/dev/null && jls -j kno.kpserver >/dev/null &&
	[ -z "$(jexec kno.kpclientd /bin/ps -ax -o comm= | grep -v -x -e daemon -e kpclientd -e ps)" ] &&
	! jexec kno.kpclientd /bin/ls /usr/jails 2>/dev/null && ! jexec kno.kpserver /bin/ls /var/lib/pq-katzenpost-authority 2>/dev/null &&
	[ -z "$(jexec kno.kpclientd jls name)" ]'
up="KNO_URL=/root/kno.bundle KNO_TEST=1 KATZENPOST_EPOCH_DURATION=1ms"
ku="jexec kno env $up"

ka='lo42|10.42.0.14'
nodes="'lo42|10.42.0.13' 'lo42|2a01:4f9:3100:4b60:1013::1'"
nodes="$nodes 'lo42|10.42.0.10' 'lo42|2a01:4f9:3100:4b60:1010::1'"
HD=/root/kno-host
EZ=/usr/local/etc/ezjail
handed="[ -f /etc/jail.conf.d/kno.conf ] && [ -f $EZ/kno.norun ] &&
	[ ! -f $EZ/kno ]"

say "a FreeBSD host with ezjail and the node keys, and no kno yet"
"$V" stop >/dev/null 2>&1 || true
"$V" start

say "the respectmy config carries the public keys of the fixture node"
vm "cat $NK/kpauthority/identity.public.pem" >"$W/identity.public.pem"
vm "cat $NK/kpauthority/link.public.pem" >"$W/link.public.pem"
gen="$src/data/networks/namenlos/.generated/configs/respectmy-pq-authority.toml"
awk -v id="$W/identity.public.pem" -v ln="$W/link.public.pem" '
function slurp(f,  l, s) { s = ""; while ((getline l < f) > 0) s = s l "\n"; close(f); return s }
BEGIN { k["IdentityPublicKey"] = slurp(id); k["LinkPublicKey"] = slurp(ln) }
skip { if (index($0, "\"\"\"")) skip = 0; next }
/^[ \t]*\[/ { me = 0 }
/^[ \t]*Identifier = "respectmy"/ { me = 1 }
me && ($1 in k) && $2 == "=" && index($3, "\"\"\"") == 1 {
	printf "%s = \"\"\"%s\"\"\"\n", $1, k[$1]
	skip = 1
	next
}
{ print }
' "$gen" >"$W/respectmy.toml"
mv "$W/respectmy.toml" "$gen"
git -C "$src" -c user.email=jacob@appelbaum.net commit -q -am \
	"fixture: respectmy carries the public keys of the fixture node"

say "the record of the release, built on Linux"
(cd "$src" && go build -o "$W/kno" ./cmd/kno)
rm -rf "$W/art"
set +e
KNO_CONFIG="$cfg" KNO_REPO="$src/data" KNO_ARTIFACTS="$W/art" "$W/kno" build --host "$host" --force >"$W/build.log" 2>&1
mark BUILD $?
set -e
rel="$W/art/releases/$tag"
record KEYS
(cd "$rel/pkgs" && sha256sum ./*.pkg | sed 's|  \./| |' | sort -k2) >"$W/cross.sums"

say "the host: check, then the jail kno with the node addresses"
vm "mkdir -p $HD"
hs="$src"/data/packaging/freebsd/host
"$V" scp "$hs"/kno-host-check "$hs"/kno-host-setup vm:$HD/
vmstep CHECK "sh $HD/kno-host-check '$ka' >/tmp/check.log 2>&1; rc=\$?; grep -E '^(FAIL|WARN)|kno-host-check' /tmp/check.log; [ \$rc = 0 ]"
vmstep SETUP "sh $HD/kno-host-setup '$ka' $nodes >/tmp/setup.log 2>&1; \
rc=\$?; tail -3 /tmp/setup.log; [ \$rc = 0 ] &&
	jls -j kno -n devfs_ruleset | grep -qx devfs_ruleset=4 && jls -j kno -n enforce_statfs | grep -qx enforce_statfs=1 &&
	jls -j kno -n children.max | grep -qx children.max=8 &&
	jls -j kno -n ip4.addr | grep -q 10.42.0.13 &&
	jexec kno sh -c 'command -v go && command -v git' >/dev/null &&
	! pkg info -e kno &&
	! grep -q 'jail_\* variables' /tmp/setup.log && $handed"

say "a jail kno that ezjail starts goes to rc.d/jail"
vmstep HANDOVER "service jail stop kno >/dev/null &&
	rm /etc/jail.conf.d/kno.conf &&
	sysrc jail_list-=kno >/dev/null && ezjail-admin config -r run kno &&
	ezjail-admin start kno >/dev/null 2>&1 && jls -j kno >/dev/null &&
	sh $HD/kno-host-setup '$ka' $nodes >/tmp/hand.log 2>&1; rc=\$?;
	grep -v ^name= /tmp/hand.log | head -4; [ \$rc = 0 ] &&
	! grep -q 'jail_\* variables' /tmp/hand.log && $handed &&
	jls -j kno -n children.max | grep -qx children.max=8 &&
	jls -j kno -n ip4.addr | grep -q 10.42.0.13"

say "the jail kno builds the release, and the node keys go to its state"
ship
vmstep KNO "jexec kno git clone -q /root/kno.bundle /root/network-organizer && ls $KJ/root/network-organizer/cmd/kno >/dev/null"
"$V" scp "$cfg" vm:$KJ/usr/local/etc/kno.toml
pk=/root/.local/share/katzenpost/kno/releases/$tag/pkgs
vmstep BUILD_IN_KNO "jexec kno sh -c 'cd /root/network-organizer && go run ./cmd/kno build -v' >/tmp/b.log 2>&1; rc=\$?; tail -2 /tmp/b.log; grep -A8 'does not match\|records no digest' /tmp/b.log | head -12; [ \$rc = 0 ] &&
	grep -q 'the build matches the record of katzenpost ${tag#v}' /tmp/b.log &&
	jexec kno sh -c 'pkg add $pk/kno-0*.pkg $pk/kno-host-config-*.pkg' \
	>/dev/null &&
	jexec kno kno --version && ! jexec kno kno --version | grep -q v0.0.0 &&
	jexec kno service cron onestop >/dev/null"
vmstep STATE "for j in kpauthority kpserver; do \
install -d -m 700 $ST/\$j && cp -p $NK/\$j/*.pem $ST/\$j/ || exit 1; done"

say "the first kno update installs the release and starts the child jails"
vmstep FIRST "$ku VERIFY_STUB=ok /usr/local/bin/kno update \
>/tmp/u1.log 2>&1; \
grep -E 'install|start|pending|ERROR' /tmp/u1.log | tail -8; \
grep -q pending /tmp/u1.log"
vmstep JAILS "$new && ! pkg info -e katzenpost && \
[ \"\$(readlink $KR/kpauthority/running)\" = \
\"\$(readlink $KR/kpauthority/current)\" ]"
vmstep LISTEN "$listen"
vmstep READONLY "$readonly"
vmstep ISOLATED "$isolated"
vmstep CLIENT "jexec kno jexec kpclientd /bin/sh -c 'test -x /usr/local/bin/kpfetch && test -f /usr/local/etc/kpclientd/thinclient.toml'"
keys KEYS_FIRST

say "the run after it promotes the release"
vmstep PROMOTE "$ku VERIFY_STUB=ok /usr/local/bin/kno update >/tmp/u2.log 2>&1; grep -E 'promoted|ERROR' /tmp/u2.log | tail -3; grep -q promoted /tmp/u2.log &&
	jexec kno kno status 2>/dev/null | grep -q 'last-good:  $tag'"
vm "cd $KJ/root/.local/share/katzenpost/kno/releases/$tag/pkgs && sha256 -r katzenpost-*.pkg namenlos-config-*.pkg" | sort -k2 >"$W/native.sums"
if [ "$(wc -l <"$W/native.sums")" -ge 3 ] &&
	join -a 1 -e MISSING -o 0,1.1,2.1 -1 2 -2 2 "$W/native.sums" "$W/cross.sums" |
	awk '{ n++ } $3 == "MISSING" { bad = 1; print "UNPAIRED " $1; next }
		$2 != $3 { bad = 1; print "DIFF " $1; next } { print "SAME " $1 }
		END { exit bad || n < 3 }' >>"$log"; then
	mark REPRO 0
else
	mark REPRO 1
fi

say "a reboot brings the jail kno and its children back"
boot0=$(vm 'sysctl -n kern.boottime' 2>/dev/null)
con=/var/tmp/kno-fbsd-vm/console.log
lines=$(wc -l <"$con")
vm "(sleep 2; shutdown -r now) >/dev/null 2>&1 &"
i=0
until b=$(vm 'sysctl -n kern.boottime' 2>/dev/null) && [ -n "$b" ] && [ "$b" != "$boot0" ]; do
	i=$((i + 1))
	[ "$i" -lt 120 ] || break
	sleep 5
done
vmstep REBOOT "sleep 20; $new && $listen"
if tail -n +"$lines" "$con" | grep -q 'Starting jails: kno' &&
	! tail -n +"$lines" "$con" | grep -q 'jail_\* variables'; then
	mark BOOT_CONSOLE 0
else
	mark BOOT_CONSOLE 1
fi
keys KEYS_REBOOT
"$V" stop

rc=0
for m in BUILD RECORD_KEYS CHECK SETUP HANDOVER KNO BUILD_IN_KNO STATE \
	FIRST JAILS LISTEN READONLY ISOLATED CLIENT KEYS_FIRST PROMOTE REPRO \
	REBOOT BOOT_CONSOLE KEYS_REBOOT; do
	if grep -q "^${m}_RC=0\$" "$log"; then echo "  $m: pass"; else echo "  $m: FAIL"; rc=1; fi
done
echo "transcript: $log"
[ "$rc" = 0 ] && echo "freebsd kno test: PASS" || echo "freebsd kno test: FAIL"
exit "$rc"
