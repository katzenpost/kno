#!/bin/sh
# shellcheck disable=SC2016
set -eu

SELF=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
V="$SELF/kno-freebsd-vm"
src="${1:?usage: kno-freebsd-kno <scratch checkout> <kno.toml>}"
cfg="${2:?usage: kno-freebsd-kno <scratch checkout> <kno.toml>}"
W="${KNO_FBSD_KNO_DIR:-/var/tmp/kno-fbsd-kno}"
host="${KNO_FBSD_KNO_HOST:-pietje}"
tag="${KNO_FBSD_KNO_TAG:-v0.0.107}"
log="$W/run.log"
J=/usr/jails
K=/var/jail/kno
D=$K/data
RS=$J/respectmy/var/lib/pq-katzenpost-authority

export GIT_SSH_COMMAND=false GIT_TERMINAL_PROMPT=0 SSH_ASKPASS_REQUIRE=never
mkdir -p "$W"
: >"$log"

say() { echo "== $*" | tee -a "$log"; }
keys() {
	if "$V" keys >"$W/keys.out" 2>&1; then mark "$1" 0; else mark "$1" 1; fi
	cat "$W/keys.out" >>"$log"
}
mark() { echo "${1}_RC=$2" | tee -a "$log"; }
vm() { "$V" ssh "$@"; }
ship() {
	git -C "$src" bundle create "$W/kno.bundle" "$(git -C "$src" branch --show-current)" HEAD >/dev/null 2>&1
	"$V" scp "$W/kno.bundle" vm:$D/kno.bundle
}
record() {
	if git -C "$src" update-ref refs/remotes/origin/main HEAD &&
		KNO_CONFIG="$cfg" KNO_REPO="$src/data" KNO_ARTIFACTS="$W/art" "$W/kno" build --host "$host" >>"$W/build.log" 2>&1 &&
		KNO_REPO="$src/data" "$W/kno" build record --dir "$rel/pkgs" >>"$W/build.log" 2>&1 &&
		git -C "$src" add "data/networks/namenlos/.generated/releases/$tag" &&
		git -C "$src" -c user.email=jacob@appelbaum.net commit -q -m "fixture: record $1"; then
		mark "RECORD_$1" 0
	else
		mark "RECORD_$1" 1
	fi
}
vmstep() {
	vm "export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin; { $2; } 2>&1; echo ${1}_RC=\$?" 2>&1 | tee -a "$log"
}
old='pgrep -lf -j respectmy "katzenpost-wrapper|katzenpost-dirauth" && pgrep -lf -j allmixedup "katzenpost-wrapper|/usr/local/bin/server"'
noold='! pgrep -lf "katzenpost-wrapper|katzenpost-dirauth|/usr/local/bin/server"'
new='[ "$(jls -j respectmy path)" = /var/jail/kno/respectmy ] && [ "$(jls -j allmixedup path)" = /var/jail/kno/allmixedup ] &&
	[ "$(jls -j kpclient path)" = /var/jail/kno/kpclient ] &&
	procstat -b "$(cat /var/jail/kno/respectmy/var/run/katzenpost.child.pid)" | grep -q "/usr/local/sbin/kpdirauth$" &&
	procstat -b "$(cat /var/jail/kno/allmixedup/var/run/katzenpost.child.pid)" | grep -q "/usr/local/sbin/kpserver$" &&
	procstat -b "$(cat /var/jail/kno/kpclient/var/run/kpclientd.child.pid)" | grep -q "/usr/local/bin/kpclientd$"'
listen='sockstat -46 -l -j respectmy | grep -q "kpdirauth.*:1984 " && sockstat -46 -l -j allmixedup | grep -q "kpserver.*:8443 "'
readonly='for j in respectmy allmixedup kpclient; do for d in / /etc /usr /usr/local/etc /bin /var; do
		if jexec $j /bin/sh -c ": >$d/kno-w" 2>/dev/null; then echo "WRITABLE $j:$d"; exit 1; fi; done
		for d in /var/run /tmp /var/log; do jexec $j /bin/sh -c ": >$d/kno-w && rm $d/kno-w" || exit 1; done; done &&
	jexec respectmy /bin/sh -c ": >/var/lib/pq-katzenpost-authority/kno-w && rm /var/lib/pq-katzenpost-authority/kno-w"'
up="KNO_URL=$D/kno.bundle KNO_TEST=1 KATZENPOST_EPOCH_DURATION=1ms"

operator() {
	vmstep "${1}_BACKUP" 'mkdir -p /root/pre-kno/respectmy /root/pre-kno/allmixedup &&
		cp -p /etc/crontab /root/pre-kno/ &&
		cp -p /usr/jails/respectmy/usr/local/etc/rc.d/katzenpost /root/pre-kno/respectmy/ &&
		cp -p /usr/jails/respectmy/usr/local/etc/katzenpost/authority/config.toml /root/pre-kno/respectmy/ &&
		cp -p /usr/jails/allmixedup/usr/local/etc/rc.d/katzenpost /root/pre-kno/allmixedup/ &&
		cp -p /usr/jails/allmixedup/usr/local/etc/katzenpost/allmixedup-pq-gatewaynode.toml /root/pre-kno/allmixedup/ &&
		mkdir -p '"$D"' && { pkg delete -fy go git >/dev/null 2>&1 || true; } && ! command -v go && ! command -v git &&
		jexec mixbuilder pkg info -e go && jexec mixbuilder pkg info -e git'
	ship
	vmstep "${1}_KNO" "grep -q '^$D ' /etc/fstab.mixbuilder || echo '$D $J/mixbuilder$D nullfs rw 0 0' >>/etc/fstab.mixbuilder;
		mkdir -p $J/mixbuilder$D && ezjail-admin restart mixbuilder >/dev/null 2>&1 && jexec mixbuilder test -f $D/kno.bundle &&
		rm -rf $D/network-organizer && jexec mixbuilder git clone -q $D/kno.bundle $D/network-organizer && ls $D/network-organizer/cmd/kno"
	"$V" scp "$cfg" vm:/usr/local/etc/kno.toml
	vmstep "${1}_BUILD" "cp /usr/local/etc/kno.toml $D/kno.toml &&
		jexec mixbuilder env HOME=$D KNO_CONFIG=$D/kno.toml KNO_HOST=$host sh -c 'cd $D/network-organizer && go run ./cmd/kno build -v' >/tmp/b.log 2>&1; rc=\$?; tail -2 /tmp/b.log; grep -A8 'does not match\|records no digest' /tmp/b.log | head -12; [ \$rc = 0 ] &&
		grep -q 'matches the committed digest list for $tag' /tmp/b.log &&
		pkg add $D/.local/share/katzenpost/kno/releases/$tag/pkgs/kno-0*.pkg >/dev/null && pkg info -e kno && kno --version && ! kno --version | grep -q v0.0.0"
	vmstep "${1}_JAILS" "ezjail-admin create kpclient 'lo42|10.42.0.30' >/dev/null 2>&1 &&
		for j in kpclient respectmy allmixedup; do ezjail-admin stop \$j >/dev/null 2>&1; ezjail-admin config -r norun \$j || exit 1; done &&
		sed -i '' 's|^\\(23,53.*update-mixes\\)|#\\1|' /etc/crontab && grep -q '^#23,53.*update-mixes' /etc/crontab &&
		$noold && ls /usr/local/etc/ezjail/ | grep -c norun | grep -qx 3"
}

say "the VM as the jail host is today: hand-built daemons and update-mixes"
"$V" stop >/dev/null 2>&1 || true
"$V" start
keys KEYS_START
vmstep OLD_RUNS "$old"

say "the fixture: the respectmy config carries the VM's own respectmy public keys"
vm "cat $RS/identity.public.pem" >"$W/identity.public.pem"
vm "cat $RS/link.public.pem" >"$W/link.public.pem"
gen="$src/data/networks/namenlos/.generated/configs/respectmy-pq-authority.toml"
awk -v id="$W/identity.public.pem" -v ln="$W/link.public.pem" '
function slurp(f,  l, s) { s = ""; while ((getline l < f) > 0) s = s l "\n"; close(f); return s }
BEGIN { k["IdentityPublicKey"] = slurp(id); k["LinkPublicKey"] = slurp(ln) }
skip { if (index($0, "\"\"\"")) skip = 0; next }
/^[ \t]*\[/ { me = 0 }
/^[ \t]*Identifier = "respectmy"/ { me = 1 }
me && ($1 in k) && $2 == "=" && index($3, "\"\"\"") == 1 {
	printf "%s = \"\"\"%s\"\"\"\n", $1, k[$1]
	skip = 1
	next
}
{ print }
' "$gen" >"$W/respectmy.toml"
mv "$W/respectmy.toml" "$gen"
git -C "$src" -c user.email=jacob@appelbaum.net commit -q -am "fixture: respectmy carries the fixture VM's own public keys"

say "the record of the fixture's release, built on Linux"
(cd "$src" && go build -o "$W/kno" ./cmd/kno)
rm -rf "$W/art"
set +e
KNO_CONFIG="$cfg" KNO_REPO="$src/data" KNO_ARTIFACTS="$W/art" "$W/kno" build --host "$host" --force >"$W/build.log" 2>&1
mark BUILD $?
set -e
rel="$W/art/releases/$tag"
record KEYS
(cd "$rel/pkgs" && sha256sum ./*.pkg | sed 's|  \./| |' | sort -k2) >"$W/cross.sums"

say "the operator: kno builds in the build jail, and the host gets only the kno package"
operator OP

say "the first kno update"
vmstep FIRST "$up VERIFY_STUB=ok kno update >/tmp/u1.log 2>&1; rc=\$?; grep -E 'install|start the read-only|pending|ERROR' /tmp/u1.log | tail -10; [ \$rc = 0 ]"
vmstep JAILS "sleep 5; $noold && $new && ! pkg info -e katzenpost && [ -x $K/.kp/$tag/usr/local/sbin/kpdirauth ] && ! pkg -r $J/respectmy info -e katzenpost && [ -d $K/.skel/respectmy ]"
vmstep LISTEN "$listen"
vmstep READONLY "$readonly"
keys KEYS_FIRST
vmstep SCHEDULE 'kno schedule cron >/tmp/sc.log 2>&1; cat /tmp/sc.log | tail -2;
	grep -q "^23,53 \* \* \* \* root /usr/local/bin/kno update >>/var/log/kno-update.log 2>&1$" /usr/local/etc/cron.d/kno-update &&
	grep -q "^/var/log/kno-update.log" /usr/local/etc/newsyslog.conf.d/kno.conf && newsyslog -n >/dev/null'

say "the run after it promotes the release"
vmstep PROMOTE "$up VERIFY_STUB=ok kno update >/tmp/u2.log 2>&1; rc=\$?; grep -E 'promoted|ERROR' /tmp/u2.log | tail -3; [ \$rc = 0 ] && grep -q promoted /tmp/u2.log &&
	kno status 2>/dev/null | grep -q 'last-good:  $tag' && pkg info -e kno"
vm "cd $D/.local/share/katzenpost/kno/releases/$tag/pkgs && sha256 -r katzenpost-*.pkg namenlos-config-*.pkg" | sort -k2 >"$W/native.sums"
if [ "$(wc -l <"$W/native.sums")" -ge 4 ] &&
	join -a 1 -e MISSING -o 0,1.1,2.1 -1 2 -2 2 "$W/native.sums" "$W/cross.sums" |
	awk '{ n++ } $3 == "MISSING" { bad = 1; print "UNPAIRED " $1; next }
		$2 != $3 { bad = 1; print "DIFF " $1; next } { print "SAME " $1 }
		END { exit bad || n < 4 }' >>"$log"; then
	mark REPRO 0
else
	mark REPRO 1
fi

say "the cron line itself, with the environment that cron gives it"
vmstep CRONRUN "cmd=\$(sed -n 's/^23,53 \* \* \* \* root //p' /usr/local/etc/cron.d/kno-update); before=\$(wc -c </var/log/kno-update.log 2>/dev/null || echo 0);
	env -i HOME=/root SHELL=/bin/sh PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin sh -c \"\$cmd\"; after=\$(wc -c </var/log/kno-update.log);
	tail -3 /var/log/kno-update.log; [ \$after -gt \$before ] && grep -q 'Nothing to do' /var/log/kno-update.log && ! grep -q ERROR /var/log/kno-update.log"

say "a reboot brings the kno jails back, and ezjail leaves the old ones down"
vm "(sleep 2; shutdown -r now) >/dev/null 2>&1 &"
sleep 20
i=0
until vm true >/dev/null 2>&1; do
	i=$((i + 1))
	[ "$i" -lt 100 ] || break
	sleep 3
done
vmstep REBOOT "sleep 20; $new && $noold && $listen"

say "a config change at the same tag: recorded, then installed"
level() {
	sed -i "s/^level = \".*\"/level = \"$1\"/" "$src/data/networks/namenlos/editable-configs/nodes/allmixedup-gateway.toml"
	sed -i "s/^  Level = \".*\"/  Level = \"$1\"/" "$src/data/networks/namenlos/.generated/configs/allmixedup-pq-gatewaynode.toml"
	git -C "$src" -c user.email=jacob@appelbaum.net commit -q -am "fixture: allmixedup logs at $1"
}
gw=$J/allmixedup/usr/local/etc/katzenpost/allmixedup-pq-gatewaynode.toml
level INFO
ship
vmstep CONFIG_UNRECORDED "$up VERIFY_STUB=ok kno update >/tmp/c0.log 2>&1; rc=\$?; grep -E 'records no digest' /tmp/c0.log | head -1; [ \$rc != 0 ] && grep -q 'records no digest for: namenlos-config-allmixedup-pq-gatewaynode-' /tmp/c0.log && ! grep -q 'Level = \"INFO\"' $gw"
record INFO
ship
vmstep CONFIG "$up VERIFY_STUB=ok kno update >/tmp/c1.log 2>&1 && $up VERIFY_STUB=ok kno update >>/tmp/c1.log 2>&1; grep -E 'new config packages|promoted' /tmp/c1.log; tail -4 /tmp/c1.log; grep -q 'new config packages for allmixedup-pq-gatewaynode' /tmp/c1.log &&
	grep -q promoted /tmp/c1.log && grep -q 'Level = \"INFO\"' $gw && $new"
vmstep CONFIG_SAME "$up VERIFY_STUB=ok kno update >/tmp/c2.log 2>&1; grep -qi 'nothing to do' /tmp/c2.log"

say "a config change that fails verify rolls back to the configs before it"
level DEBUG
record DEBUG
ship
vmstep CONFIG_ROLLBACK "$up VERIFY_STUB=ok kno update >/tmp/c3.log 2>&1 && $up VERIFY_STUB=fail kno update >>/tmp/c3.log 2>&1; grep -E 'new config packages|earlier config packages|did not pass verify' /tmp/c3.log; tail -4 /tmp/c3.log; grep -q 'kno installs the earlier config packages again' /tmp/c3.log && grep -q 'Level = \"INFO\"' $gw && $new && kno status 2>/dev/null | grep -q \"quarantine: none\""
vmstep CONFIG_HELD "$up VERIFY_STUB=ok kno update >/tmp/c4.log 2>&1; tail -3 /tmp/c4.log; grep -q 'did not pass verify, and kno rolled them back' /tmp/c4.log"

say "a newer kno in the repository upgrades kno on the host"
printf 'package cli\n\nconst fixtureMark = 1\n' >"$src/internal/cli/fixture_mark.go"
git -C "$src" add internal/cli/fixture_mark.go
git -C "$src" -c user.email=jacob@appelbaum.net commit -q -m "fixture: a tool-only change"
ship
vmstep SELF "old=\$(kno --version); $up VERIFY_STUB=ok kno update >/tmp/s1.log 2>&1; grep -E 'upgrading kno|kno is now|ERROR' /tmp/s1.log; new=\$(kno --version); echo \"\$old -> \$new\"; [ \"\$old\" != \"\$new\" ] && grep -q 'kno is now' /tmp/s1.log && $new"
keys KEYS_END

say "a first install that fails verify, and the way back to the hand-built daemons"
"$V" stop >/dev/null 2>&1 || true
"$V" start
operator FAIL
vmstep FAIL_INSTALL "$up VERIFY_STUB=fail kno update >/tmp/f1.log 2>&1; $up VERIFY_STUB=fail kno update >>/tmp/f1.log 2>&1; rc=\$?; grep -E 'quarantin|did not pass verify|ERROR' /tmp/f1.log | tail -4;
	[ \$rc != 0 ] && grep -q 'kno cannot roll back' /tmp/f1.log && $new"
back='service jail stop respectmy
ezjail-admin config -r run respectmy
ezjail-admin start respectmy
service jail stop allmixedup
ezjail-admin config -r run allmixedup
ezjail-admin start allmixedup'
printf '%s\n' "$back" >"$W/way-back.sh"
"$V" scp "$W/way-back.sh" vm:/root/way-back.sh
vmstep WAY_BACK "[ \$(grep -c . /root/way-back.sh) = 6 ] && sh -x /root/way-back.sh && sleep 8 && $old && service -j respectmy katzenpost status && service -j allmixedup katzenpost status"
keys KEYS_BACK
"$V" stop

rc=0
for m in KEYS_START OLD_RUNS BUILD RECORD_KEYS OP_BACKUP OP_KNO OP_BUILD OP_JAILS FIRST JAILS LISTEN READONLY KEYS_FIRST \
	SCHEDULE PROMOTE REPRO CRONRUN REBOOT CONFIG_UNRECORDED RECORD_INFO CONFIG CONFIG_SAME RECORD_DEBUG \
	CONFIG_ROLLBACK CONFIG_HELD SELF KEYS_END FAIL_BACKUP FAIL_KNO FAIL_BUILD FAIL_JAILS FAIL_INSTALL WAY_BACK KEYS_BACK; do
	if grep -q "^${m}_RC=0\$" "$log"; then echo "  $m: pass"; else echo "  $m: FAIL"; rc=1; fi
done
echo "transcript: $log"
[ "$rc" = 0 ] && echo "freebsd kno test: PASS" || echo "freebsd kno test: FAIL"
exit "$rc"
