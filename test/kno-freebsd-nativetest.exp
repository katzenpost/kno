#!/usr/bin/expect -f
set timeout 2400
set disk    [lindex $argv 0]
set scratch [lindex $argv 1]
set knourl  [lindex $argv 2]
set repourl [lindex $argv 3]
set vars    [lindex $argv 4]
set ovmf    [lindex $argv 5]
set smp [expr {[info exists ::env(KNO_VMTEST_SMP)] ? $::env(KNO_VMTEST_SMP) : 4}]
set mem [expr {[info exists ::env(KNO_VMTEST_MEM)] ? $::env(KNO_VMTEST_MEM) : 4096}]

spawn qemu-system-x86_64 -enable-kvm -m $mem -smp $smp \
    -drive if=pflash,format=raw,unit=0,readonly=on,file=$ovmf \
    -drive if=pflash,format=raw,unit=1,file=$vars \
    -drive file=$disk,if=virtio -snapshot \
    -drive file=$scratch,if=virtio \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
    -display none -serial stdio -monitor none

expect {
    timeout { puts "\nTIMEOUT waiting for login"; exit 2 }
    -re "login: ?$" { send "root\r" }
}
expect {
    timeout { puts "\nTIMEOUT after username"; exit 2 }
    -re "assword:" { send "\r"; exp_continue }
    -re "root@" { }
}

send "\r"
expect -re "\[#$] $"
send "KP1=KNO; KP2='> '; PS1=\"\$KP1\$KP2\"\r"
expect -re "KNO> $"

proc run {cmd tmo} {
    send "$cmd\r"
    set oldt $::timeout
    set ::timeout $tmo
    expect {
        timeout { puts "\nTIMEOUT on: $cmd"; exit 2 }
        -re "KNO> $" { }
    }
    set ::timeout $oldt
}

run "dhclient vtnet0 2>/dev/null; ifconfig vtnet0 | grep 'inet '" 60
run "newfs -U /dev/vtbd1 >/dev/null 2>&1; mkdir -p /big; mount /dev/vtbd1 /big; rc=\$?; df -h /big /; echo BIGDISK_RC=\$rc" 180

run "env ASSUME_ALWAYS_YES=yes pkg install -y go git >/tmp/pkginst.log 2>&1; rc=\$?; tail -2 /tmp/pkginst.log; echo TOOLS_RC=\$rc" 1200
run "go version; git --version" 60

run "fetch -q -o /tmp/kno $knourl && chmod +x /tmp/kno && ls -l /tmp/kno || echo FETCH_FAIL" 120
run "mkdir -p /root/repo && fetch -q -o /tmp/repo.tar.gz $repourl && tar -xzf /tmp/repo.tar.gz -C /root/repo && ls /root/repo/data/thirdparty/pins.env >/dev/null 2>&1; echo REPO_RC=\$?" 180

run "/tmp/kno build --help 2>&1 | grep -c 'native' >/dev/null; echo KNOHELP_RC=\$?" 60
run "mkdir -p /big/home /big/gomod /big/gocache /big/tmp /big/art; echo DIRS_RC=\$?" 60

run "cd /root/repo && env KNO_REPO=/root/repo HOME=/big/home KNO_ARTIFACTS=/big/art KNO_CACHE=/big/knocache GOMODCACHE=/big/gomod GOCACHE=/big/gocache TMPDIR=/big/tmp /tmp/kno build --native --binary-only >/big/build.log 2>&1; rc=\$?; tail -6 /big/build.log; echo NATIVE_RC=\$rc" 3600
run "ls -l /big/art/releases/*/pkgs/*.pkg 2>/dev/null | head -3; ls /big/art/releases/*/pkgs/*.pkg >/dev/null 2>&1; echo PKGMADE_RC=\$?" 60
run "ls -l /big/art/releases/*/bin/ 2>/dev/null | head -12; ls /big/art/releases/*/bin/dirauth /big/art/releases/*/bin/server >/dev/null 2>&1; echo RELBIN_RC=\$?" 60
run "file /big/art/releases/*/bin/server 2>/dev/null | head -1" 60
run "/tmp/kno fpkg --verify /big/art/releases/*/pkgs/katzenpost-*.pkg; echo FPKGVERIFY_RC=\$?" 120

run "env ASSUME_ALWAYS_YES=yes pkg add /big/art/releases/*/pkgs/*.pkg >/tmp/add.log 2>&1; rc=\$?; tail -3 /tmp/add.log; echo SELFADD_RC=\$rc" 300
run "pkg info -l katzenpost 2>&1 | head -5" 60
run "/usr/local/sbin/kpdirauth -v >/tmp/da.log 2>&1; rc=\$?; head -1 /tmp/da.log; echo RUN_RC=\$rc" 60

send "poweroff\r"
expect {
    timeout { exit 0 }
    eof { }
}
