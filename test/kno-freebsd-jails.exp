#!/usr/bin/expect -f
set timeout 3600
set disk      [lindex $argv 0]
set jailsdisk [lindex $argv 1]
set knourl    [lindex $argv 2]
set repourl   [lindex $argv 3]
set baseurl   [lindex $argv 4]
set vars      [lindex $argv 5]
set ovmf      [lindex $argv 6]
set smp [expr {[info exists ::env(KNO_VMTEST_SMP)] ? $::env(KNO_VMTEST_SMP) : 2}]
set mem [expr {[info exists ::env(KNO_VMTEST_MEM)] ? $::env(KNO_VMTEST_MEM) : 4096}]

spawn qemu-system-x86_64 -enable-kvm -m $mem -smp $smp \
    -drive if=pflash,format=raw,unit=0,readonly=on,file=$ovmf \
    -drive if=pflash,format=raw,unit=1,file=$vars \
    -drive file=$disk,if=virtio -snapshot \
    -drive file=$jailsdisk,if=virtio,format=qcow2 \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
    -display none -serial stdio -monitor none

expect {
    timeout { puts "\nTIMEOUT waiting for login"; exit 2 }
    -re "login: ?$" { send "root\r" }
}
expect {
    timeout { puts "\nTIMEOUT after username"; exit 2 }
    -re "assword:" { send "\r"; exp_continue }
    -re "root@" { }
}
send "\r"
expect -re "\[#$] $"
send "KP1=KNO; KP2='> '; PS1=\"\$KP1\$KP2\"\r"
expect -re "KNO> $"

proc run {cmd tmo} {
    send "$cmd\r"
    set oldt $::timeout
    set ::timeout $tmo
    expect {
        timeout { puts "\nTIMEOUT on: $cmd"; exit 2 }
        -re "KNO> $" { }
    }
    set ::timeout $oldt
}

run "dhclient vtnet0 2>/dev/null; ifconfig vtnet0 | grep 'inet '" 60
run "newfs -U /dev/vtbd1 >/dev/null 2>&1 && mkdir -p /jails && mount /dev/vtbd1 /jails && df -h /jails | tail -1; echo JAILFS_RC=\$?" 180
run "fetch -q -o /tmp/base.txz $baseurl; echo BASEDL_RC=\$?" 900

run "for j in mixbuilder respectmy allmixedup; do mkdir -p /jails/\$j; tar -xf /tmp/base.txz -C /jails/\$j; cp /etc/resolv.conf /jails/\$j/etc/resolv.conf; done; ls /jails/mixbuilder/bin/sh /jails/respectmy/bin/sh /jails/allmixedup/bin/sh >/dev/null 2>&1; echo JAILS_RC=\$?" 900
run "rc=0; for j in mixbuilder respectmy allmixedup; do jail -c name=\$j path=/jails/\$j host.hostname=\$j.local ip4=inherit allow.raw_sockets persist || rc=1; done; jls | wc -l; echo JAILUP_RC=\$rc" 180

run "env ASSUME_ALWAYS_YES=yes pkg bootstrap -y >/tmp/boot.log 2>&1; rc=\$?; tail -1 /tmp/boot.log; echo HOSTPKG_RC=\$rc" 600
run "env ASSUME_ALWAYS_YES=yes pkg -c /jails/mixbuilder install -y go git >/tmp/tools.log 2>&1; rc=\$?; tail -6 /tmp/tools.log; echo TOOLS_RC=\$rc" 1800
run "jexec mixbuilder /bin/sh -c 'go version && git --version' >/tmp/toolchk.log 2>&1; rc=\$?; head -2 /tmp/toolchk.log; echo TOOLCHK_RC=\$rc" 120
run "fetch -q -o /jails/mixbuilder/tmp/kno $knourl && chmod +x /jails/mixbuilder/tmp/kno; echo KNODL_RC=\$?" 180
run "mkdir -p /jails/mixbuilder/root/repo && fetch -q -o /tmp/repo.tar.gz $repourl && tar -xzf /tmp/repo.tar.gz -C /jails/mixbuilder/root/repo; echo REPO_RC=\$?" 300

run "jexec mixbuilder /bin/sh -c 'cd /root/repo && env KNO_REPO=/root/repo KNO_ARTIFACTS=/root/art /tmp/kno build --native --services respectmy-pq-authority,allmixedup-pq-gatewaynode' >/tmp/build.log 2>&1; rc=\$?; tail -6 /tmp/build.log; echo BUILD_RC=\$rc" 3000
run "P=\$(ls -d /jails/mixbuilder/root/art/releases/*/pkgs 2>/dev/null | head -1); echo \"pkgs in \$P\"; ls \$P" 60
run "ls \$P/katzenpost-*.pkg >/dev/null 2>&1; echo BINPKG_RC=\$?" 60
run "ls \$P/namenlos-config-respectmy-pq-authority-*.pkg >/dev/null 2>&1; echo CFGPKG1_RC=\$?" 60
run "ls \$P/namenlos-config-allmixedup-pq-gatewaynode-*.pkg >/dev/null 2>&1; echo CFGPKG2_RC=\$?" 60

run "cp \$P/katzenpost-*.pkg /jails/respectmy/tmp/ && cp \$P/katzenpost-*.pkg /jails/allmixedup/tmp/ && cp \$P/namenlos-config-respectmy-*.pkg /jails/respectmy/tmp/ && cp \$P/namenlos-config-allmixedup-*.pkg /jails/allmixedup/tmp/; echo COPY_RC=\$?" 120
run "jexec respectmy /bin/sh -c 'env ASSUME_ALWAYS_YES=yes pkg add /tmp/katzenpost-*.pkg /tmp/namenlos-config-*.pkg' >/tmp/add1.log 2>&1; rc=\$?; tail -3 /tmp/add1.log; echo ADD1_RC=\$rc" 600
run "jexec allmixedup /bin/sh -c 'env ASSUME_ALWAYS_YES=yes pkg add /tmp/katzenpost-*.pkg /tmp/namenlos-config-*.pkg' >/tmp/add2.log 2>&1; rc=\$?; tail -3 /tmp/add2.log; echo ADD2_RC=\$rc" 600

run "cat /jails/respectmy/usr/local/etc/rc.conf.d/katzenpost; echo RC1_RC=\$?" 60
run "cat /jails/allmixedup/usr/local/etc/rc.conf.d/katzenpost; echo RC2_RC=\$?" 60
run "jexec respectmy /bin/sh -c 'service katzenpost rcvar' >/tmp/rv1.log 2>&1 && grep 'katzenpost_enable=\"YES\"' /tmp/rv1.log; echo RCVAR1_RC=\$?" 60

run "jexec respectmy /bin/sh -c 'service katzenpost start' >/tmp/s1.log 2>&1; rc=\$?; tail -2 /tmp/s1.log; echo START1_RC=\$rc" 180
run "sleep 5; jexec respectmy /bin/sh -c 'service katzenpost status' >/tmp/st1.log 2>&1; rc=\$?; tail -2 /tmp/st1.log; echo STATUS1_RC=\$rc" 120
run "jexec allmixedup /bin/sh -c 'service katzenpost start' >/tmp/s2.log 2>&1; rc=\$?; tail -2 /tmp/s2.log; echo START2_RC=\$rc" 180
run "sleep 5; jexec allmixedup /bin/sh -c 'service katzenpost status' >/tmp/st2.log 2>&1; rc=\$?; tail -2 /tmp/st2.log; echo STATUS2_RC=\$rc" 120

run "jexec respectmy /bin/sh -c 'service katzenpost stop' >/dev/null 2>&1; jexec allmixedup /bin/sh -c 'service katzenpost stop' >/dev/null 2>&1; echo STOP_RC=0" 120
run "for j in allmixedup respectmy mixbuilder; do jail -r \$j >/dev/null 2>&1; done; echo TEARDOWN_RC=0" 120

send "poweroff\r"
expect {
    timeout { exit 0 }
    eof { }
}
