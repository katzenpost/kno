FROM docker.io/library/golang:1.26.10-trixie@sha256:9ba7dc6d09ebf6e9317263973174bbf44e15bdf58cb0103747d7376f7cfa2d2f
RUN echo "deb http://deb.debian.org/debian trixie-backports main" >/etc/apt/sources.list.d/backports.list \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends -t trixie-backports clang-21=1:21.1.8-3~bpo13+2 lld-21=1:21.1.8-3~bpo13+2 \
	&& ln -s /usr/bin/clang-21 /usr/local/bin/clang \
	&& ln -s /usr/bin/ld.lld-21 /usr/local/bin/ld.lld \
	&& rm -rf /var/lib/apt/lists/*
