#!/bin/sh
set -euf
cron=""
while getopts c: o; do
	case $o in
	c) cron=$OPTARG ;;
	*) echo "usage: kno-host-cutover [-c crontab-pattern] [jail-to-set-aside ...]" >&2; exit 2 ;;
	esac
done
shift $((OPTIND - 1))
E=/usr/local/etc/ezjail
J=/usr/jails
[ -r /usr/local/etc/ezjail.conf ] && J=$(sh -c '. /usr/local/etc/ezjail.conf; echo "${ezjail_jaildir:-/usr/jails}"')
K=$J/kno
F=$K/var/db/kno/cutover
B=/root/kno-cutover
var() { sed -n "s/^export jail_$(printf %s "$2" | tr -c 'A-Za-z0-9' _)_$3=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p" "$1"; }
die() { echo "kno-host-cutover: $*" >&2; exit 1; }

jls -j kno >/dev/null 2>&1 || die "the jail kno does not run: run kno-host-setup"
[ -s "$F" ] || die "no $F: run kno activate in the jail kno first"
[ ! -s "$K/etc/rc.conf.d/jail" ] || die "the cutover is done already: $K/etc/rc.conf.d/jail exists"
hc=$(find "$K/root/.local/share/katzenpost/kno/releases" -path '*/pkgs/kno-host-config-*.pkg' 2>/dev/null | sort | tail -1)
[ -n "$hc" ] || die "no kno-host-config package in the jail kno: run kno build there first"
names=""
while read -r new old dir files; do
	[ -L "$K/var/db/kno/roots/$new/current" ] || die "the jail $new has no package root: run kno activate in the jail kno"
	[ -f "$K/etc/jail.conf.d/$new.conf" ] || die "the jail $new has no definition: run kno activate in the jail kno"
	if [ "$old" != - ]; then
		f=$E/$old
		[ -f "$f" ] || f=$E/$old.norun
		[ -f "$f" ] || die "no ezjail $old"
		[ -n "$(find "$(var "$f" "$old" rootdir)$dir" -maxdepth 1 -type f -name '*.pem' -print -quit 2>/dev/null)" ] ||
			die "no key files in $(var "$f" "$old" rootdir)$dir"
	fi
	names="$names $new"
done <"$F"

mkdir -p "$B"
trap 'echo "kno-host-cutover: a step failed and the cutover stopped. To return to the old jails: sh $(dirname "$0")/kno-host-back $*" >&2' EXIT
[ -f "$B/crontab" ] || cp -p /etc/crontab "$B/crontab"
[ -f "$B/kno" ] || cp -p "$E/kno" "$B/kno"
stamp=$(date +%Y%m%d%H%M%S)
if [ -n "$cron" ]; then
	sed -i '' "s|^\([^#].*$cron\)|#\1|" /etc/crontab
	grep -n "$cron" /etc/crontab || true
fi
for j in "$@"; do
	jls -j "$j" >/dev/null 2>&1 && ezjail-admin stop "$j"
	[ -f "$E/$j" ] && ezjail-admin config -r norun "$j"
done

ips=$(var "$B/kno" kno ip)
while read -r new old dir files; do
	[ "$old" != - ] || continue
	f=$E/$old
	[ -f "$f" ] || f=$E/$old.norun
	root=$(var "$f" "$old" rootdir)
	ips="$ips,$(var "$f" "$old" ip)"
	jls -j "$old" >/dev/null 2>&1 && ezjail-admin stop "$old" </dev/null
	[ -f "$E/$old" ] && ezjail-admin config -r norun "$old" </dev/null
	if ds=$(zfs list -H -o name "$root$dir" 2>/dev/null); then
		zfs snapshot "$ds@kno-cutover-$stamp" && echo "snapshot $ds@kno-cutover-$stamp"
	fi
	dst=$K/var/db/kno/state/$new
	mkdir -p "$dst"
	chmod 700 "$dst"
	for p in $files; do
		if [ -z "$(find "$root$dir" -maxdepth 1 -type f -name "$p" -print -quit)" ]; then
			case $p in
			*.pem) die "no $root$dir/$p to copy for $new" ;;
			*) echo "no $p in $old; $new starts without it"; continue ;;
			esac
		fi
		find "$root$dir" -maxdepth 1 -type f -name "$p" -exec cp -p {} "$dst/" \;
	done
	echo "copied from $old to $new: $(find "$dst" -type f | sed 's|.*/||' | sort | tr '\n' ' ')"
done <"$F"

n=$(grep -c . "$F")
p=$(var "$E/kno" kno parameters | tr ' ' '\n' | grep -v '^children.max=' | tr '\n' ' ')
awk -v ips="$ips" -v params="children.max=$n ${p% }" '
/^export jail_kno_ip=/ { print "export jail_kno_ip=\"" ips "\""; next }
/^export jail_kno_parameters=/ { print "export jail_kno_parameters=\"" params "\""; next }
{ print }' "$E/kno" >"$E/kno.new"
mv "$E/kno.new" "$E/kno"
printf 'jail_enable="YES"\njail_list="%s"\n' "${names# }" >"$K/etc/rc.conf.d/jail"
for new in $names; do
	ln -sfh "$(readlink "$K/var/db/kno/roots/$new/current")" "$K/var/db/kno/roots/$new/running"
done
ezjail-admin restart kno
jexec kno pkg add "${hc#"$K"}" >/dev/null
for new in $names; do
	jls -j "kno.$new" >/dev/null 2>&1 || die "the jail kno.$new did not start; see $K/var/log/jails/$new"
	sockstat -46l -j "kno.$new" | awk 'NR > 1 { print "kno.'"$new"' listens " $2 " " $6 }' | sort -u
done
trap - EXIT
echo "kno-host-cutover: the jails$names run in the jail kno. Next: jexec kno kno update"
